# Generated output
# This will ignore the entire output directory, including the SQLite database.
output/

# Environment variables
# Do not commit secrets or local configuration.
.env

# Virtual Environment
# Ignore the virtual environment directory.
venv/
.venv/
env/
ENV/

# Python cache and artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# IDE & Editor folders
.vscode/
.idea/

# OS-specific files (macOS)
.DS_Store

# Log files
*.log
